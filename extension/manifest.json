{
  "manifest_version": 3,
  "name": "Omarchy Theme",
  "version": "0.1",
  "description": "Live Omarchy theme palette as CSS variables on every page",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://mail.google.com/*"],
      "css": ["sites/gmail.css"],
      "run_at": "document_start"
    }
  ]
}
